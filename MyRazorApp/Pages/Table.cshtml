@page
@using MyApp.Namespace
@model MyApp.Namespace.TableModel
@{
}
    <div class="container">
    <form method="post" asp-page-handler="LogOut">
    <button type="submit" class="btn btn-danger">Logout</button>
    </form>
    

    <p style="font: 15px;font-family: Arial, Helvetica, sans-serif;font-weight:bold;"> 
        UserName : @Request.Cookies["Username"] | User Role : @Request.Cookies["UserRole"]</p>


    <div class="row">
        <div class="col-md-6 form-container">
            <h2 class="section-header">Add New Class</h2>
            <form method="post">
                <!-- Prompt Make a form that Changes when an entity is not null -->
                @if (Model.Db_EditedClass != null)
                {
                    <input type="hidden" name="id" value="@Model.Db_EditedClass.Id" />
                }
                <div class="form-group">
                    <label for="ClassName">Class Name</label>
                    <input type="text" class="form-control" id="ClassName" name="className" value="@Model.Db_EditedClass?.Name" required />
                </div>

                <div class="form-group">
                    <label for="StudentCount">Student Count</label>
                    <input type="number" class="form-control" id="StudentCount" name="studentCount" value="@Model.Db_EditedClass?.PersonCount" required />
                </div>

                <div class="form-group">
                    <label for="Description">Description</label>
                    <input type="text" class="form-control" id="Description" name="description" value="@Model.Db_EditedClass?.Description" required />
                </div>

                @if (Model.Db_EditedClass == null)
                {
                    <button type="submit" class="btn btn-primary action-btn" asp-page-handler="Add">Add Class</button>
                }
                else
                {
                    <button type="submit" class="btn btn-warning action-btn" asp-page-handler="Edit">Save Changes</button>
                }
            </form>
        </div>
        <!-- Prompt: make a table that lists elements of ClassList <ClassInformationModel> -->
        <div class="col-md-6 table-container">
            <h2 class="section-header">Class List</h2>

            <!-- Prompt : How do i keep the values of MinStudentCount,MaxStudentCount after a get request form is submited-->
            <form method="get">
                <div class="form-group">
                    <label for="minStudentCount">Min Student Count</label>
                    <input type="number" id="minStudentCount" name="minStudentCount" class="form-control" value="@Model.MinStudentCount" />
                </div>

                <div class="form-group">
                    <label for="maxStudentCount">Max Student Count</label>
                    <input type="number" id="maxStudentCount" name="maxStudentCount" class="form-control" value="@Model.MaxStudentCount" />
                </div>

                <button type="submit" class="btn btn-primary">Filter</button>
            </form>

            <form method="post">
                @for (int i = 0; i < (TableModel.Db_selectedClasses.Count + 9) / 10; i++)
                {
                    @if (TableModel.CurrentPage != i + 1)
                    {
                        <button type="submit" name="Page" class="btn btn-primary action-btn" value="@(i + 1)" asp-page-handler="ChangePage">@(i + 1)</button>
                    }
                    @if (TableModel.CurrentPage == i + 1)
                    {
                        <button type="submit" name="Page" class="btn btn-primary action-btn" value="@(i + 1)" asp-page-handler="ChangePage" disabled>@(i + 1)</button>
                    }
                }
                <!-- Prompt : How do i keep the values of MinStudentCount,MaxStudentCount after a post request-->
                <input type="hidden" id="minStudentCountHidden" name="minStudentCount" value="@Model.MinStudentCount" />
                <input type="hidden" id="maxStudentCountHidden" name="maxStudentCount" value="@Model.MaxStudentCount" />
            </form> 

            <br>
            <table class="table">
                <form method="post">
                    <button type="submit" class="btn btn-success action-btn" asp-page-handler="ExportJson">Export to Json</button>
                        <input type="hidden" id="minStudentCountHidden" name="minStudentCount" value="@Model.MinStudentCount" />
                        <input type="hidden" id="maxStudentCountHidden" name="maxStudentCount" value="@Model.MaxStudentCount" />
                    <p style="font: 15px;font-family: Arial, Helvetica, sans-serif;font-weight:bold;">
                        If a column is selected only selected columns will be exported to the JSON</p>
                     <p style="font: 15px;font-family: Arial, Helvetica, sans-serif;font-weight:bold;">
                        If no column is selected all columns will be exported to the JSON </p>
                    <p style="font: 15px;font-family: Arial, Helvetica, sans-serif;font-weight:bold;">
                        The exported JSON can be found in wwwroot/JSON</p>                     
                <thead>
                    <tr>
                        <th class="checkbox-th">    
                            <input type="checkbox" class="checkbox-input" name="selectedColumns[]" value="Name" /><br>Class Name
                        </th>
                        <th class="checkbox-th">
                            <input type="checkbox" class="checkbox-input" name="selectedColumns[]" value="PersonCount" />Student Count
                        </th>
                        <th class="checkbox-th">
                            <input type="checkbox" class="checkbox-input" name="selectedColumns[]" value="Description" />Description
                        </th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Prompt: make a table that lists elements of ClassList <ClassInformationModel> -->
                    @for (int i = 0; i < TableModel.Db_ClassTable_page.Count; i++)
                    {
                        var item = TableModel.Db_ClassTable_page[i];
                        <tr>
                            <td style="background: rgb(136, 223, 218);">@item.ClassName</td>
                            <td style="background: rgb(97, 241, 234);">@item.StudentCount</td>
                            <td style="background: rgb(136, 223, 218);">@item.Description</td>
                            <td class="action-buttons" style="background: rgb(97, 241, 234); vertical-align: middle;">
                                <a href="@Url.Page("./Table", new { id = item.Id, handler = "Edit" })" class="btn btn-warning table-btn" style="justify-content: center;">
                                    <img src="/images/pencil.png" style="width: 30px; height: 30px;">
                                </a>
                                <form method="post" class="delete-form">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger table-btn" asp-page-handler="Delete" style="justify-content: center;">
                                        <img src="/images/trash.png" style="width: 30px; height: 30px;">
                                    </button>
                                </form>
                            </td>
                        </tr>
                        }
                </tbody>
            </form>
        </table>
            


            <form method="post">
                @for (int i = 0; i < (TableModel.Db_selectedClasses.Count + 9) / 10; i++)
                {
                    @if (TableModel.CurrentPage != i + 1)
                    {
                        <button type="submit" name="Page" class="btn btn-primary action-btn" value="@(i + 1)" asp-page-handler="ChangePage">@(i + 1)</button>
                    }
                    @if (TableModel.CurrentPage == i + 1)
                    {
                        <button type="submit" name="Page" class="btn btn-primary action-btn" value="@(i + 1)" asp-page-handler="ChangePage" disabled>@(i + 1)</button>
                    }
                }
                <!-- Prompt : How do i keep the values of MinStudentCount,MaxStudentCount after a post request-->
                <input type="hidden" id="minStudentCountHidden" name="minStudentCount" value="@Model.MinStudentCount" />
                <input type="hidden" id="maxStudentCountHidden" name="maxStudentCount" value="@Model.MaxStudentCount" />
            </form>
        </div>
    </div>
</div>